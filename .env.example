# Application
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_ENV=development
PLATFORM_ADMIN_EMAILS=

# Supabase (use separate projects for development, staging, and production)
