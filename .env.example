# OpenAI — no mock fallback is used when these are absent
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_WEBHOOK_SECRET=

# Meta Business / Facebook Pages / Instagram Professional
META_CLIENT_ID=
META_CLIENT_SECRET=
