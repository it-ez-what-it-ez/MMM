# GrowthOS runs entirely with deterministic local providers by default.
AI_PROVIDER=mock

# Optional server-only remote JSON provider. Set AI_PROVIDER=remote to enable.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_BASE_URL=

# Optional real ChatGPT Ads Advertiser API key from https://ads.openai.com.
# It is server-only and scoped to one OpenAI Ads account.
OPENAI_ADS_API_KEY=

# Optional Reddit Ads API v3 OAuth connection. Request adsread + adsedit.
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REFRESH_TOKEN=
REDDIT_AD_ACCOUNT_ID=
REDDIT_ADS_PROFILE_ID=
REDDIT_ADS_FUNDING_INSTRUMENT_ID=
# Use an honest application identifier, e.g. web:growthos:v1.0 (by /u/yourname).
REDDIT_ADS_USER_AGENT=
