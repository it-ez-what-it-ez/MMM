# GrowthOS runs entirely with deterministic local providers by default.
AI_PROVIDER=mock

# Optional server-only remote JSON provider. Set AI_PROVIDER=remote to enable.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_BASE_URL=

# Required before any workspace can store provider credentials. Generate 32 random
# bytes and base64 encode them. Rotating this value requires reconnecting accounts.
PROVIDER_TOKEN_ENCRYPTION_KEY=

# Public origin used in provider OAuth callback URLs.
APP_BASE_URL=http://localhost:3000

# Google Ads OAuth application plus the developer token issued through a manager
# account. Register /api/oauth/google/callback as an authorized redirect URI.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# Meta app with Marketing API and Facebook Login. Register
# /api/oauth/meta/callback and request advanced access for third-party accounts.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_GRAPH_API_VERSION=v24.0

# Reddit Ads OAuth app. Register /api/oauth/reddit/callback and request
# adsread + adsedit.
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
# Use an honest application identifier, e.g. web:growthos:v1.0 (by /u/yourname).
REDDIT_ADS_USER_AGENT=

# Optional legacy single-account ChatGPT Ads fallback. New workspace connections
# are entered in the UI and stored encrypted. OpenAI currently issues one API key
# per ad account instead of advertiser OAuth.
OPENAI_ADS_API_KEY=
