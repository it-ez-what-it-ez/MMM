# Application
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_ENV=development
PLATFORM_ADMIN_EMAILS=

# Supabase (use separate projects for development, staging, and production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PROVIDER_TOKEN_ENCRYPTION_KEY=
GROWTHOS_WORKER_SECRET=
GROWTHOS_CRON_SECRET=
GROWTHOS_SITE_BYPASS_TOKEN=

# Manual production evidence. Set true only after the named workflow has been
# tested in the production Supabase project; these do not configure Supabase.
SUPABASE_AUTH_URLS_VERIFIED=false
SUPABASE_CUSTOM_SMTP_VERIFIED=false
SUPABASE_BACKUPS_VERIFIED=false
SUPABASE_LEGACY_KEYS_DISABLED=false
SUPABASE_DATABASE_SSL_ENFORCED=false
LEGAL_DOCUMENTS_APPROVED=false

# OpenAI — no mock fallback is used when these are absent
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_WEBHOOK_SECRET=

# Meta Business / Facebook Pages / Instagram Professional
META_CLIENT_ID=
META_CLIENT_SECRET=
META_LOGIN_CONFIGURATION_ID=
META_GRAPH_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=

# Google Ads and GA4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=

# TikTok Ads
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=

# TikTok Organic Login Kit / Content Posting
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Reddit Ads
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LinkedIn Pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608

# ChatGPT Ads Early Access (platform partner access still required)
CHATGPT_ADS_ENABLED=false

# Customer-owned Twilio / SendGrid accounts. Enable only after the platform
# readiness row and real smoke test pass in this environment.
TWILIO_MESSAGING_ENABLED=false
SENDGRID_EMAIL_ENABLED=false

# Production email and monitoring
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASSWORD=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_INSTRUMENTATION_VERIFIED=false
